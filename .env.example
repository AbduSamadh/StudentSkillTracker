# Copy to .env for docker compose. Production values come from a secret manager.
STEM_ENVIRONMENT=development
POSTGRES_PASSWORD=change-me
STEM_OWNER_PASSWORD=change-me
STEM_APP_PASSWORD=change-me
STEM_BACKUP_PASSWORD=change-me
# age public keys that backups are encrypted to (age-keygen -y identity.txt > this file).
# Keep the private key offline; it is only needed for restores and the restore drill.
BACKUP_AGE_RECIPIENTS_FILE=./deploy/backup-recipients.txt
MINIO_ROOT_USER=stemtrack
MINIO_ROOT_PASSWORD=change-me-long-secret
STEM_PUBLIC_BASE_URL=http://localhost:8080
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
STEM_JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STEM_FIELD_ENCRYPTION_KEY=
STEM_BLIND_INDEX_KEY=
